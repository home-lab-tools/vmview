<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="VmView.App"
             RequestedThemeVariant="Light">
    <Application.Resources>
        <!-- Light palette: paper canvas, white bars and cards, slate text, one blue accent, green for "live". -->
        <SolidColorBrush x:Key="BgBrush" Color="#F4F6F9" />
        <SolidColorBrush x:Key="StageBrush" Color="#E6EAF0" />
        <SolidColorBrush x:Key="BarBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="LineBrush" Color="#E2E8F0" />
        <SolidColorBrush x:Key="LineStrongBrush" Color="#CBD5E1" />
        <SolidColorBrush x:Key="HoverBrush" Color="#F1F5F9" />
        <SolidColorBrush x:Key="FgBrush" Color="#0F172A" />
        <SolidColorBrush x:Key="DimBrush" Color="#64748B" />
        <SolidColorBrush x:Key="AccentBrush" Color="#2563EB" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#1D4ED8" />
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#DBEAFE" />
        <SolidColorBrush x:Key="LiveBrush" Color="#16A34A" />
        <SolidColorBrush x:Key="LiveSoftBrush" Color="#DCFCE7" />
        <SolidColorBrush x:Key="LiveTextBrush" Color="#166534" />
        <SolidColorBrush x:Key="ErrorBrush" Color="#DC2626" />
        <SolidColorBrush x:Key="ErrorHoverBrush" Color="#B91C1C" />
    </Application.Resources>
    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://VmView/Styles/Theme.axaml" />
    </Application.Styles>
</Application>
